  "routing_rules": {
    "complexity_to_level": {
      "0_10": 1,
      "11_25": 2,
      "26_50": 3,
      "51_75": 4,
      "76_100": 5
    },
    "escalation_triggers": [
      {"trigger": "token_estimate_exceeds_budget", "action": "escalate_one_level"},
      {"trigger": "capability_not_found", "action": "escalate_one_level"},
      {"trigger": "error_rate_above_0.3", "action": "escalate_two_levels"},
      {"trigger": "requires_human_flag_set", "action": "route_to_opus"},
      {"trigger": "security_sensitive", "action": "route_to_opus"},
      {"trigger": "new_domain_unknown", "action": "route_to_opus"}
    ],
    "de_escalation_triggers": [
      {"trigger": "task_is_pure_bash", "max_level": 2},
      {"trigger": "task_is_hash_only", "max_level": 1},
      {"trigger": "task_is_json_validate", "max_level": 1}
    ]
  },
  "endpoints": {
    "local_ollama": {
