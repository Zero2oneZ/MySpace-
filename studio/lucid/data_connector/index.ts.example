// Stand-in types so this file documents the shape without compiling.
type Action = (payload: any) => Promise<any>;
interface Connector {
  defineAsynchronousAction(name: string, fn: Action): void;
  defineAction(name: string, fn: Action): void;
}

declare const connector: Connector;

