[configuration]
entry_symbol = "mspc_library_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libmspc.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libmspc.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libmspc.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libmspc.windows.template_release.x86_64.dll"
macos.debug = "res://bin/libmspc.macos.template_debug.framework"
macos.release = "res://bin/libmspc.macos.template_release.framework"
macos.debug.arm64 = "res://bin/libmspc.macos.template_debug.arm64.framework"
macos.release.arm64 = "res://bin/libmspc.macos.template_release.arm64.framework"
