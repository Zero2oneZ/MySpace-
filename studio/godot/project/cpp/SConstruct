#!/usr/bin/env python
# SCons build for MySpace++ Godot GDExtension
# Requires godot-cpp submodule (or GODOT_CPP_PATH env var)

import os
import sys

env = SConscript("godot-cpp/SConstruct")
env.Append(CPPPATH=["include"])

# Add our source files
sources = Glob("src/*.cpp")

# Compiler flags for spatial/inference math
env.Append(CPPDEFINES=["MSPC_GDEXT"])
env.Append(CCFLAGS=["-O3", "-ffast-math"])
if env["target"] == "debug":
    env.Append(CCFLAGS=["-g", "-DDEBUG"])

# Create the shared library
if env["platform"] == "macos":
    library = env.SharedLibrary(
        "../bin/libmspc.{}.{}.framework/libmspc.{}.{}".format(
            env["platform"], env["target"], env["platform"], env["target"]
        ),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        "../bin/libmspc{}{}".format(
            env["suffix"], env["SHLIBSUFFIX"]
        ),
        source=sources,
    )

Default(library)
